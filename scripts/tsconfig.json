{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    // DOM provides WebCrypto's CryptoKey type, used by packages/integrations (imported by
    // scripts/spike); Node's own types declare it only as a value.
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
