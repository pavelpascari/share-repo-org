{
  "name": "@sharerepo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c ../../apps/web/wrangler.jsonc",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote -c ../../apps/web/wrangler.jsonc",
    "db:migrate:prod": "wrangler d1 migrations apply DB --remote -c ../../apps/web/wrangler.jsonc --env production"
  },
  "dependencies": {
    "@sharerepo/domain": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261018.1",
    "drizzle-kit": "0.31.11"
  }
}
